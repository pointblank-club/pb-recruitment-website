VITE_API_BASE_URL=http://localhost:8080

VITE_FIREBASE_API_KEY=<firebase-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<firebase-project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<messaging-sender-id>
VITE_FIREBASE_APP_ID=<firebase-app-id>

# Temporary judging stand-in for PBR-2. Opt in only when testing the polling UI
# without a judge worker; otherwise local development should use the real API.
VITE_MOCK_SUBMISSION_JUDGING=false

# Optional crash reporting. Replay and tracing are disabled.
VITE_SENTRY_DSN=

# Build-only: configure these in the deployment environment, never with VITE_ prefixes.
# SENTRY_AUTH_TOKEN=<source-map-upload-token>
# SENTRY_ORG=<organization-slug>
# SENTRY_PROJECT=<project-slug>
# SENTRY_RELEASE=<commit-sha> (defaults to VERCEL_GIT_COMMIT_SHA or git HEAD)
